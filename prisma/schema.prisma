generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime @default(now())
  listeningEnabled      Boolean   @default(false)
  shareListeningHistory Boolean   @default(false)
  sharingChoiceMade     Boolean   @default(false)
  listeningSyncedAt     DateTime?

  accounts      Account[]
  sessions      Session[]
  entries       JournalEntry[]
  recentAlbums  RecentAlbum[]
}

model RecentAlbum {
  userId      String
  spotifyId   String
  entryKind   EntryKind
  title       String
  artistName  String?
  releaseDate String?
  imageUrl    String?
  playedAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, spotifyId])
  @@index([playedAt])
  @@index([spotifyId, playedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model JournalEntry {
  id          String      @id @default(cuid())
  userId      String
  spotifyType SpotifyType
  entryKind   EntryKind
  spotifyId   String
  title       String
  subtitle    String?
  artistName  String?
  albumName   String?
  releaseDate String?
  imageUrl    String?
  spotifyUrl  String
  sourceUrl   String
  notes       String?
  rating      Float?
  addedAt     DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, addedAt])
  @@unique([userId, spotifyType, spotifyId])
}

enum SpotifyType {
  TRACK
  ALBUM
  PLAYLIST
}

enum EntryKind {
  TRACK
  ALBUM
  EP
  PLAYLIST
}
